# GlucoSafe Backend Configuration Example

# Server
PORT=3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=glucosafe

# SSL/TLS (TiDB Cloud / cloud MySQL)
# Isi DB_SSL_CA untuk mengaktifkan TLS. Kosongkan untuk DB lokal.
# DB_SSL_CA=
# Backend tidak punya flag disable; SSL hanya aktif bila DB_SSL_CA di-set.

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Machine Learning API. Backend appends /api/predict.
ML_API_URL=http://127.0.0.1:5000
# Do not enable mock mode. Real screening rejects ML_MOCK_MODE=true.
